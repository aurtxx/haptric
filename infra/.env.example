# Copy to infra/.env for local development. Values below are development-only.
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_platform
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DEPLOYMENT_MODE=lan
INSTALLATION_ID=local-dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
HAPTRIC_NODE_ID=demo-lan-node
HAPTRIC_NODE_ROLE=lan
HAPTRIC_SYNC_URL=http://127.0.0.1:8001/api/v1/sync/push/
HAPTRIC_SYNC_TOKEN=replace-with-a-local-only-sync-token
HAPTRIC_SYNC_ORGANIZATION_ID=replace-with-demo-organization-uuid
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
